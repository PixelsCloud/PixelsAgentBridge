+/// Decision returned by [`ForwardingControl`] for a relay datagram.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ForwardingDecision {
+    /// Forward the datagram now.
+    Allow,
+    /// Recheck after this delay. The source connection is backpressured while waiting.
+    Wait(Duration),
+    /// Drop the datagram without forwarding it.
+    Drop,
+}
+
+/// Controls datagram forwarding after source and destination identities are known.
+///
+/// Implementations must return quickly and must not block the async runtime. Shared
+/// rate limiters can update a short critical section and return [`ForwardingDecision::Wait`].
+pub trait ForwardingControl: std::fmt::Debug + Send + Sync + 'static {
+    /// Checks whether a datagram can be forwarded now.
+    fn check(
+        &self,
+        src: EndpointId,
+        dst: EndpointId,
+        bytes: usize,
+    ) -> ForwardingDecision;
+}
+
+/// Dynamic form of [`ForwardingControl`].
+pub trait DynForwardingControl: std::fmt::Debug + Send + Sync + 'static {
+    /// See [`ForwardingControl::check`].
+    fn check(
+        &self,
+        src: EndpointId,
+        dst: EndpointId,
+        bytes: usize,
+    ) -> ForwardingDecision;
+}
+
+impl<T: ForwardingControl> DynForwardingControl for T {
+    fn check(
+        &self,
+        src: EndpointId,
+        dst: EndpointId,
+        bytes: usize,
+    ) -> ForwardingDecision {
+        <Self as ForwardingControl>::check(self, src, dst, bytes)
+    }
+}
+
+/// Forwarding policy that allows every datagram immediately.
+#[derive(Debug, Clone, Copy)]
+pub struct AllowAllForwarding;
+
+impl ForwardingControl for AllowAllForwarding {
+    fn check(
+        &self,
+        _src: EndpointId,
+        _dst: EndpointId,
+        _bytes: usize,
+    ) -> ForwardingDecision {
+        ForwardingDecision::Allow
     }
 }
 
