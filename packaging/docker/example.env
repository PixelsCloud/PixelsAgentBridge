# Keep this UUID unchanged for the lifetime of a deployment.
PAB_DEPLOYMENT_ID=replace-with-a-random-uuid

# Use a URL-safe value here because Compose inserts it into PAB_DATABASE_URL.
PAB_DB_PASSWORD=change-me
PAB_REGISTRATION_ENABLED=true

# Paths are resolved relative to packaging/docker/compose.yaml.
PAB_CERT_DIR=./certs
PAB_RELAY_CONTROL_SECRET_PATH=./secrets/relay-control-secret

# Each certificate must contain the matching name in its DNS SAN.
PAB_BACKEND_TLS_NAME=pab.rgaa.vip
PAB_RELAY_TLS_NAME=pab-relay.rgaa.vip

# HTTPS remains on loopback for an existing TLS-aware reverse proxy.
PAB_BACKEND_HOST_IP=127.0.0.1
PAB_BACKEND_HOST_PORT=31400
PAB_RELAY_HTTPS_HOST_IP=127.0.0.1
PAB_RELAY_HTTPS_HOST_PORT=31443

# iroh QUIC is published directly.
PAB_RELAY_QUIC_HOST_IP=0.0.0.0
PAB_RELAY_QUIC_HOST_PORT=7842
