# Compose orchestration only. Application settings live in config/*.toml.
# Postgres container bootstrap: must match database.url in pab-server.toml.
PAB_DB_PASSWORD=change-me
PAB_DB_NAME=pab
PAB_SERVER_IMAGE=pixels-agent-bridge:release
# PAB_RELAY_IMAGE=pixels-agent-bridge:release

# Host paths, relative to compose.yaml. Recreate containers after config edits.
PAB_SERVER_CONFIG=./config/pab-server.toml
PAB_RELAY_CONFIG=./config/pab-relay-server.toml
PAB_CERT_DIR=./certs
# Optional internal network alias; must match relay control.url and TLS SAN.
PAB_BACKEND_DNS_ALIAS=backend
PAB_RELAY_DNS_ALIAS=relay

PAB_BACKEND_HOST_IP=127.0.0.1
PAB_BACKEND_HOST_PORT=31400
PAB_RELAY_HTTPS_HOST_IP=127.0.0.1
PAB_RELAY_HTTPS_HOST_PORT=31443
PAB_RELAY_QUIC_HOST_IP=0.0.0.0
PAB_RELAY_QUIC_HOST_PORT=7842
