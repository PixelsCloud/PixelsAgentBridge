FROM rust:1.95-bullseye AS rust-toolchain
FROM ubuntu:22.04 AS dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        ca-certificates build-essential pkg-config clang cmake nasm curl file xz-utils \
        libwebkit2gtk-4.1-dev libgtk-3-dev libepoxy-dev libayatana-appindicator3-dev \
        librsvg2-dev libxdo-dev libssl-dev libxrandr-dev libxext-dev libxfixes-dev libxdamage-dev libxtst-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH \
    CARGO_BUILD_JOBS=8 CMAKE_BUILD_PARALLEL_LEVEL=2
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends libpipewire-0.3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends libgbm-dev libdrm-dev \
    && rm -rf /var/lib/apt/lists/*
